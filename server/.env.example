# ─── Admin Credentials ─────────────────────────────────────────────────────────
# These are checked at login time. Set a strong password in production.
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_strong_password_here

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate a random 64-char string: openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_string_in_production

# ─── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Get this from Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get these from Supabase Dashboard → Settings → API
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (your frontend domains)
ALLOWED_ORIGINS=http://localhost:5173,https://misphaministries.com,https://www.misphaministries.com

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3002
