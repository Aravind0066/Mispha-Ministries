# ─── Frontend Environment Variables ────────────────────────────────────────────
# These are embedded at BUILD TIME by Vite (must start with VITE_)

# The URL where your Express backend is hosted (no trailing slash)
# Leave empty during local dev (Vite proxy handles it)
# In production (Vercel): set to your Render backend URL, e.g. https://mispha-api.onrender.com
VITE_API_URL=
